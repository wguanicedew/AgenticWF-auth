# Runtime configuration for the agenticwf-auth container (docker/podman --env-file).

# Public URLs served by host Caddy. Pick the layout matching your Caddyfile:
#
#  A) one hostname, port 443 only (deploy/caddy/sites/agenticwf-single-host.caddyfile)
#       LOGTO_ENDPOINT=https://host.example.org
#       LOGTO_ADMIN_ENDPOINT=http://localhost:3002      (SSH tunnel; the default)
#         or https://host.example.org:8443 with the admin-console add-on (development)
#       APP_ORIGIN=https://host.example.org
#       APP_BASE_PATH=/app
#
#  B) separate hostnames (deploy/caddy/sites/agenticwf-multi-host.caddyfile)
#       LOGTO_ENDPOINT=https://auth.example.org
#       LOGTO_ADMIN_ENDPOINT=https://auth-admin.example.org
#       APP_ORIGIN=https://app.example.org
#       APP_BASE_PATH=
LOGTO_ENDPOINT=https://host.example.org
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# API resource indicator(s) created in the Logto console (API resources). Tokens must be
# requested with this `resource`. Add `urn:logto:organization:*` to accept organization tokens.
AUTH_AUDIENCES=https://api.example.org

# --- Browser access (chat UI, status pages, live updates) -------------------------
# Logto application of type "Traditional web"; redirect URI
# ${APP_ORIGIN}${APP_BASE_PATH}/auth/callback, post sign-out redirect URI
# ${APP_ORIGIN}${APP_BASE_PATH}/. Leave AUTH_WEB_CLIENT_ID unset to disable.
APP_ORIGIN=https://host.example.org
APP_BASE_PATH=/app
AUTH_WEB_CLIENT_ID=
# Stored in /var/lib/agenticwf/secrets on first boot; may be removed from this file afterwards.
AUTH_WEB_CLIENT_SECRET=
# OIDC scopes + the API permissions the web UI needs.
AUTH_WEB_SCOPES=openid profile email offline_access app:access agent:use knowledge:read
# AUTH_SESSION_IDLE_TTL=28800
# AUTH_SESSION_MAX_TTL=604800
# Logto Account Center, linked next to the user's name (enable it first, docs/deployment.md §4.4e).
# AUTH_ACCOUNT_URL=https://host.example.org/account

# --- Personal access tokens for the CLI (Admin > Tokens in the web UI) -------------
# Logto "Machine-to-machine" app with the "Logto Management API access" role; leave
# AUTH_MGMT_CLIENT_ID unset to disable. AUTH_CLI_CLIENT_ID (the Native app) is shown to
# users so they can configure `agenticwf`; enable "token exchange" on that app.
# AUTH_MGMT_CLIENT_ID=
# AUTH_MGMT_CLIENT_SECRET=
# AUTH_CLI_CLIENT_ID=
# AUTH_PAT_MAX_DAYS=365

# Optional — generated on first boot and stored in /var/lib/agenticwf/secrets if unset.
# LOGTO_DB_PASSWORD=
# AUTHSVC_DB_PASSWORD=
# AUTH_CONTEXT_SECRET=

# Networking. With `docker run --network host` set LISTEN_HOST=127.0.0.1 so no service
# listens on the host's public interfaces; with bridge networking (-p 127.0.0.1:...) keep 0.0.0.0.
# LISTEN_HOST=0.0.0.0
# PGPORT=5432          # change if the host already uses 5432 (host networking)

# Optional tuning.
# AUTHSVC_WORKERS=2
# AUTHSVC_LOG_LEVEL=info
# AUTH_CONTEXT_TTL=60
# AUTH_ROLES_CLAIM=roles
# AUTH_POLICY_FILE=/etc/agenticwf/policy.yaml
# LOGTO_AUTO_ALTERATION=0

# OpenTelemetry (docs/deployment.md, Tracing and metrics): off unless an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318      # OTLP/HTTP: Jaeger, an OpenTelemetry Collector, ...
# OTEL_METRICS_EXPORTER=otlp                          # metrics too (not to plain Jaeger)
# OTEL_SERVICE_NAME=agenticwf-auth
